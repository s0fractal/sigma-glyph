.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo

# Python packaging build artifacts (pyproject.toml / pip install .)
build/
dist/
*.egg-info/
.venv*/

# Secrets: never committed. A token in git history is a token that must be revoked.
.env
.env.*
!.env.example
papers/*/paper.pdf

# Downloaded historical deposits, verified against the Zenodo record.
# External inputs, not repository artifacts; see the deposit manifest.
papers/*/v1-deposited/
papers/*/v2-staging/
